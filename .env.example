# Copy this file to .env.local and fill in the values from your Supabase project:
#   URL -> Project Settings -> Data API -> Project URL
#   Key -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Use ONE of these two keys:
# a) the "anon public" key (starts with eyJ...) from the "Legacy API Keys" tab
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# b) or the newer publishable key (starts with sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
